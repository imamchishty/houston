# Set HOUSTON_MODE=demo to run against bundled fixture data (no Jira needed)
HOUSTON_MODE=demo
PORT=4000

# Jira Cloud or Data Center
JIRA_BASE_URL=https://m42.atlassian.net
JIRA_EMAIL=you@m42.ae
JIRA_API_TOKEN=xxxx
# Comma separated Jira board ids to track, with a display name: "OSSI:42,PLAT:57"
JIRA_BOARDS=OSSI:42
# Optional: custom field id for acceptance criteria (otherwise description is scanned)
JIRA_AC_FIELD=
# Story points field (Jira Cloud default is customfield_10016)
JIRA_POINTS_FIELD=customfield_10016
# Epic Link field, so tickets can be costed per feature (team-managed projects use the parent epic instead)
JIRA_EPIC_FIELD=customfield_10014
# Number of past closed sprints to pull per board
SPRINT_HISTORY=6

# Where scorecards are persisted (JSON store, swap for Postgres later)
HOUSTON_DATA_DIR=./data

# SonarQube: server URL, user token, and project key per board: "OSSI:m42-ossi,PLAT:m42-platform"
SONAR_URL=https://sonar.m42.internal
SONAR_TOKEN=
SONAR_PROJECTS=OSSI:m42-ossi

# Testmo: instance URL, API token, and Testmo project id per board: "OSSI:12"
TESTMO_URL=https://m42.testmo.net
TESTMO_TOKEN=
TESTMO_PROJECTS=OSSI:12

# GitHub Enterprise Server. API base is https://<host>/api/v3 (for github.com use https://api.github.com)
GITHUB_API=https://github.m42.internal/api/v3
GITHUB_TOKEN=            # read only PAT: repo (read), read:org
# Repos per board: "OSSI:m42/ossi-api|m42/ossi-web,PLAT:m42/platform"
GITHUB_REPOS=OSSI:m42/ossi-api|m42/ossi-web
GITHUB_DAYS=90
# Lane mapping, path prefix or glob fragment => area. Edit to match your repos.
GITHUB_LANES=frontend=web/,src/ui/,apps/web/;backend=api/,src/server/,services/;infra=infra/,terraform/,helm/,.github/;tests=test/,tests/,__tests__/;docs=docs/,*.md
# Which GitHub Actions workflow name counts as a production deploy (substring match)
GITHUB_DEPLOY_WORKFLOW=deploy

# Team roster per board, so people with zero activity still show up (the architect case).
# GitHub logins or display names as they appear in Jira. Optional but recommended.
TEAM_ROSTER=OSSI:Aisha|Rahul|Omar|Priya|Tom|Fatima|Karim|Dinesh

# Identity: map Jira display names and GitHub logins to one person. canonical=alias|alias;...
PEOPLE=Aisha Khan=akhan|aisha.khan;Karim Haddad=karimh

# Access. The people and recommendations endpoints and the UI require this if set. Leave blank for open (dev only).
HOUSTON_USER=imam
HOUSTON_PASSWORD=
# Comma separated names who may see per person data. Others get team level only.
HOUSTON_PEOPLE_VIEWERS=imam

# Confluence Cloud (same site as Jira). Space keys per board: "OSSI:OSSI|OSSIDOCS"
CONFLUENCE_SPACES=OSSI:OSSI
# Labels or title words that mark ADRs and runbooks (comma separated, case insensitive)
CONFLUENCE_ADR_MARKERS=adr,decision-record,architecture decision
CONFLUENCE_RUNBOOK_MARKERS=runbook,playbook,on-call

# Azure. Service principal with Reader on the subscription, Monitoring Reader on App Insights, Cost Management Reader.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_SUBSCRIPTION_ID=
# Per board: Application Insights app id (Overview blade), and the resource group or tag that holds the team's services
AZURE_APPINSIGHTS=OSSI:00000000-0000-0000-0000-000000000000
AZURE_RESOURCE_GROUPS=OSSI:rg-ossi-prod
# Log Analytics workspace id for incident and alert history
AZURE_LOG_WORKSPACE=
# Monthly loaded cost of the team in AED (salaries, contractors), for cost per feature. Optional.
TEAM_MONTHLY_COST=OSSI:850000

# Cost to build each feature. Loaded day rates in COST_CURRENCY:
# FTE = salary, benefits and overhead per working day. Contractor = the day rate paid.
COST_CURRENCY=AED
RATE_FTE_DAY=
RATE_CONTRACTOR_DAY=
# Who is a contractor, names as in TEAM_ROSTER. Everyone else is costed as FTE.
CONTRACTORS=Rahul|Priya
# Optional: an individual's own day rate, replaces the above. Never shown in the UI.
RATE_OVERRIDES=
# Working week, for cost and active days. UAE: sat,sun
WEEKEND=sat,sun

# Microsoft Teams incoming webhook for the Friday digest and Monday note (optional)
TEAMS_WEBHOOK=
# How people reach Houston, so the Teams post links to the full digest: https://houston.internal
HOUSTON_URL=

# 90 day window: start date and targets. Houston shows sprints left and on/off track.
WINDOW_START=2026-10-01
WINDOW_DAYS=90
# Offshore comparison: monthly cost of an equivalent offshore team, for cost per feature comparison
OFFSHORE_MONTHLY_COST=OSSI:280000
